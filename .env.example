# Copy to .env.local and fill in. .env* is gitignored.

# --- Required in production -------------------------------------------------

# Pepper for hashing login codes. Must be >= 16 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Resend API key for delivering login codes. Get one at https://resend.com
# Without this, codes are printed to the server console instead (development only —
# the server refuses to issue codes in production when it is missing).
RESEND_API_KEY=

# Must be a domain you have verified in Resend. The default below works for
# testing but only delivers to the address that owns the Resend account.
EMAIL_FROM="Realtime Chat <onboarding@resend.dev>"

# --- Optional ---------------------------------------------------------------

# Where the SQLite database lives. Defaults to ./data
# Point this at a mounted volume in production so data survives a redeploy.
# CHAT_DATA_DIR=/var/data

# PORT=3000
# HOST=localhost
