# Copy to .env.local and fill in. .env* is gitignored.

# --- Required in production -------------------------------------------------

# Pepper for hashing login codes. Must be >= 16 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Resend API key for delivering login codes. Get one at https://resend.com
# Without this, codes are printed to the server console instead (development only —
# the server refuses to issue codes in production when it is missing).
RESEND_API_KEY=

# The address mail is sent FROM — not your own inbox, and not an address you
# merely own. Sending from gmail.com (or any domain you do not control) is
# rejected with a 403. The default below needs no setup, but only delivers to
# the address that owns the Resend account. Verify a domain at
# https://resend.com/domains to email anyone else.
EMAIL_FROM="Whisper <onboarding@resend.dev>"

# --- Required on Vercel, optional locally -----------------------------------

# Postgres connection string. Set this and the app uses node-postgres against
# the real server; leave it unset and it uses PGlite, an in-process Postgres,
# against a local directory. Local development and CI therefore need no
# database service. Vercel has no persistent disk, so this is required there.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Redis, for state shared between instances: presence, typing and rate limits.
# Without it those live in the process, which is correct while there is only
# one. Vercel pins a socket to one instance and may put the next connection on
# another, so this is required there for presence and fan-out to be right.
# REDIS_URL=rediss://default:password@host:6379

# --- Optional ---------------------------------------------------------------

# Forces login codes to print to the server console instead of being emailed,
# even when RESEND_API_KEY is set. The test suite uses this; so can a preview
# environment that should never send real mail. Leave unset normally.
# AUTH_DEV_CONSOLE_CODES=true

# Where PGlite keeps its files when DATABASE_URL is unset. Defaults to ./data
# CHAT_DATA_DIR=./data

# PORT=3000
# HOST=localhost
